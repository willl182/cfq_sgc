{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentEmitInFileNames": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "noEmit": true,
    "outDir": "../node_modules/.cache/convex",
    "skipLibCheck": true
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
